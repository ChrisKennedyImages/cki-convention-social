# cki-convention-social: copy to .env and fill in. This file is the ONLY secrets
# source besides the process environment and the macOS Keychain (service
# com.chriskennedyimages.conventionsocial). Nothing else on the machine is read.
# Comments go on their own line: after an EMPTY value the parser reads a
# trailing comment as the value.

# --- Brand (the public name can change here at any time) ---
BRAND_NAME=Event Caliber
# the company's own domain (on Cloudflare); the site and the mail live there
BRAND_DOMAIN=eventcaliber.com
# the brand direction Chris chose: press | marquee | lens
BRAND_DIRECTION=lens
# the address mail goes out from, on BRAND_DOMAIN
BRAND_FROM_EMAIL=
# a physical mailing address, printed on every marketing email
BRAND_POSTAL_ADDRESS=
LEGAL_NAME=CKI, LLC

# --- Where everything lives (never inside the repo) ---
CCS_DATA_ROOT=~/cki-convention-social-data
TIMEZONE=America/New_York

# --- Review dashboard (127.0.0.1 only; reached from the phone over Tailscale) ---
DASHBOARD_PORT=4610
DASHBOARD_PUBLIC_URL=
# `bin/ccs hash-password` prints one; the dashboard's Keys page can change it later
DASHBOARD_PASSWORD_HASH=

# --- Google Drive: the photo library, read-only, signed in as Chris ---
# from the suite's own Google Cloud project (Desktop app OAuth client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Mail (the company mailbox on BRAND_DOMAIN; an app password, never the account password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- AI (Anthropic; this company's own key) ---
ANTHROPIC_API_KEY=
AI_MONTHLY_CAP_USD=20

# --- Buffer (this company's own Buffer account) ---
BUFFER_API_KEY=
# free | essentials | team: picks the rate-limit table
BUFFER_PLAN=essentials
# the Pinterest board pins go to: a board's serviceId from the Pinterest channel in Buffer
# (BufferClient.pinterest_boards). Empty means nothing goes to Pinterest.
PINTEREST_BOARD_ID=
# optional: the page a pin opens (the quote page, once the site exists)
PINTEREST_LINK=
# optional: posting times, local to TIMEZONE. Empty keeps the defaults:
# instagram 11:30 weekdays and 10:00 weekends, facebook 09:30, pinterest 20:30.
# One time per network ("facebook=09:30") or weekdays/weekends ("instagram=11:30/10:00").
POST_TIMES=

# --- Image hosting for Buffer (the company's own bucket, served from its own domain) ---
MEDIA_BASE_URL=
MEDIA_UPLOAD_TOKEN=
R2_ENDPOINT=
R2_BUCKET=
R2_KEY=
R2_SECRET=
R2_PUBLIC_BASE=

# --- Posting rules ---
# no same convention or person twice inside this many days
VARIETY_DAYS=14
# a photo sits out this long after it airs
PHOTO_REPEAT_DAYS=180

# --- Backups ---
# optional second location for nightly DB backups (an iCloud Drive folder, an external disk)
BACKUP_COPY_DIR=

# --- Alerts and the daily digest ---
ALERT_EMAIL=
DIGEST_HOUR=7
# this company's own ntfy.sh topic (a new, hard-to-guess name)
NTFY_TOPIC=
