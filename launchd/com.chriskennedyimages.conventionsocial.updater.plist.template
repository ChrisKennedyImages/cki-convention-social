<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chriskennedyimages.conventionsocial.updater</string>
  <key>UserName</key><string>__USER__</string>
  <key>GroupName</key><string>staff</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>convention_social.agents.updater</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CCS_DATA_ROOT</key><string>__DATA__</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__DATA__/logs/updater.launchd.log</string>
  <key>StandardErrorPath</key><string>__DATA__/logs/updater.launchd.log</string>
  <!-- Standard, not Background (2026-11-09): a Background job is kept to the six slow cores of the Mini, and the
       suite the updater runs before every deploy took 39 to 48 minutes there against 9 on the fast ones. The other
       agents stay Background; this suite is the one long piece of work every fix waits on. -->
  <key>ProcessType</key><string>Standard</string>
</dict>
</plist>
