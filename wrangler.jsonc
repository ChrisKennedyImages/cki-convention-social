// The eventcaliber.com Worker: site, booking API, availability and post images.
// First time, from the repo root, signed in to the Cloudflare account that holds eventcaliber.com:
//   npx wrangler r2 bucket create eventcaliber-media
//   npx wrangler d1 create eventcaliber-booking        (copy the database_id it prints into d1_databases below)
//   npx wrangler d1 execute eventcaliber-booking --remote --file worker/schema.sql
//   npx wrangler secret put UPLOAD_TOKEN               (the same value as MEDIA_UPLOAD_TOKEN on the Mini)
//   npx wrangler secret put NTFY_TOPIC                 (optional: a push on every quote request)
//   (SEND_TOKEN, the share sheet's, is made on the Keys page and put by every deploy from .env: site/deploy.py)
//   bin/ccs site build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventcaliber",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "observability": { "enabled": true },
  // run_worker_first (2026-10-14): without it a request that matches a page is served from the assets and the Worker
  // never runs, so www.eventcaliber.com/about/ answered 200 from the asset instead of the 301 to the apex (seen live
  // after #64). With it every request runs the Worker, which hands the site's pages to the assets binding itself.
  "assets": { "directory": "site/dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "eventcaliber-media" }],
  "d1_databases": [{ "binding": "DB", "database_name": "eventcaliber-booking", "database_id": "SET_AFTER_d1_create" }],
  // the outside watch (7.4, 2026-10-13): every 30 minutes, UTC. Cron Triggers are on the Workers Free plan
  // (5 per account; developers.cloudflare.com/workers/platform/limits, read 2026-10-13); site/deploy.py carries
  // this file to Cloudflare on every deploy.
  "triggers": { "crons": ["*/30 * * * *"] },
  "workers_dev": false,
  "routes": [
    { "pattern": "eventcaliber.com", "custom_domain": true },
    { "pattern": "www.eventcaliber.com", "custom_domain": true }
  ]
}
